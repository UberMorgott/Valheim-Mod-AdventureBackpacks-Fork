# Line endings fixed in the repo, not by core.autocrlf: agents write LF, so a fresh checkout or worktree
# of a commit must also be LF, or the compiler sees different source bytes (PDB checksums fold into the
# deterministic MVID) and the same commit builds a different DLL.
* text=auto eol=lf
*.bat text eol=crlf
*.cmd text eol=crlf

AdventureBackpacks/Assets/Bundles/* filter=lfs diff=lfs merge=lfs -text
**/Assets/StreamingAssets/* filter=lfs diff=lfs merge=lfs -text
*.tga filter=lfs diff=lfs merge=lfs -text
*.TGA filter=lfs diff=lfs merge=lfs -text
*.png filter=lfs diff=lfs merge=lfs -text
*.PNG filter=lfs diff=lfs merge=lfs -text
*.tif filter=lfs diff=lfs merge=lfs -text
*.TIF filter=lfs diff=lfs merge=lfs -text
*.tiff filter=lfs diff=lfs merge=lfs -text
*.fbx filter=lfs diff=lfs merge=lfs -text
*.FBX filter=lfs diff=lfs merge=lfs -text
*.blend filter=lfs diff=lfs merge=lfs -text
*.blend1 filter=lfs diff=lfs merge=lfs -text
*.dll filter=lfs diff=lfs merge=lfs -text
*.DLL filter=lfs diff=lfs merge=lfs -text
**/Library/ArtifactDB filter=lfs diff=lfs merge=lfs -text
*.meta !text -filter -merge -diff
