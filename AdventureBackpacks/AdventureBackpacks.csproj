        <EmbeddedResource Include="Assets\Bundles\backpack_swamp" />
    </ItemGroup>
    <ItemGroup>
        <None Include="App.config" />
    </ItemGroup>
    <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
        <EmbeddedResource Include="Translations\English.json" />
        <EmbeddedResource Include="Assets\Bundles\adventurebackpacks" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="JotunnLib" Version="2.30.0" />
        <PackageReference Include="Vsxmd" Version="1.4.6" PrivateAssets="all" />
        <PackageReference Include="YamlDotNet" Version="16.3.0" />
    </ItemGroup>
</Project>
