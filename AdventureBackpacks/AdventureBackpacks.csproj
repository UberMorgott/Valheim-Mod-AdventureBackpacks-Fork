    <ItemGroup>
        <None Include="App.config" />
    </ItemGroup>
    <ItemGroup Condition=" '$(Configuration)|$(Platform)' != 'API|AnyCPU' ">
        <EmbeddedResource Include="Translations\English.json" />
        <EmbeddedResource Include="Assets\Bundles\adventurebackpacks" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Vsxmd" Version="1.4.6" PrivateAssets="all" ExcludeAssets="runtime" />
        <!-- YamlDotNet.dll ships as its own pack plugin (BepInEx\plugins\YamlDotNet); never copy it next to ours. -->
    <PackageReference Include="YamlDotNet" Version="16.3.0" ExcludeAssets="runtime" />
    </ItemGroup>
</Project>
